{
	"tasks": {
		"build": "deno compile --allow-read --allow-write --allow-env --allow-ffi --output dist/pm3 src/cli/main.ts",
		"check": "deno check src/**/*.ts",
		"cli": "deno run --allow-read --allow-write --allow-env --allow-ffi src/cli/main.ts",
		"fmt": "deno fmt",
		"lint": "deno run --no-lock -A npm:@biomejs/biome@2.4.6 lint .",
		"test": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-run=deno",
		"test:watch": "deno test --allow-read --allow-write --allow-env --allow-ffi --watch"
	},
	"imports": {
		"@db/sqlite": "jsr:@db/sqlite@^0.13.0",
		"@soapbox/kysely-deno-sqlite": "jsr:@soapbox/kysely-deno-sqlite@^2.2.0",
		"@std/assert": "jsr:@std/assert@^1.0.15",
		"@std/path": "jsr:@std/path@^1.1.4",
		"kysely": "npm:kysely@0.27.6"
	}
}
